# NuruXplore API client configuration
# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Host only — the documented endpoints already carry the /api prefix
# (e.g. /api/auth/login), so do NOT add a trailing "/api" here.
NURUXPLORE_BASE_URL=https://nuruxplore.com

# Test-account credentials (provided separately for the exercise)
NURUXPLORE_EMAIL=your-test-account-email@example.com
NURUXPLORE_PASSWORD=your-test-account-password

# Optional: timeouts (seconds)
NURUXPLORE_TIMEOUT=30

# ---------------------------------------------------------------------------
# DeepSeek multi-agent orchestration (OPT-IN toggle)
# ---------------------------------------------------------------------------
# Set NURUXPLORE_AGENTS_ENABLED=1 AND provide a DeepInfra key to switch chat +
# research generation from the (paid, queued) nuruxplore engine to the local
# DeepSeek multi-agent graph. When unset/0 or key missing, the app behaves
# exactly as before. The key is SECRET — never commit it; set it in the
# server's .env / Docker secrets only.
#
# NURUXPLORE_AGENTS_ENABLED=0
# DEEPINFRA_API_KEY=your-deepinfra-key
# DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
# DEEPINFRA_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
# DEEPINFRA_TIMEOUT=120
# DEEPINFRA_RETRIES=2
# NURUXPLORE_AGENTS_MAX_WORKERS=3
# NURUXPLORE_AGENTS_MAX_ROUNDS=2
